#!/usr/bin/env python3
"""Feeds the Voyager keymap overlay.

  voyager-keymap fetch [--layout <oryx url or hash>]
      Writes the layout to $XDG_STATE_HOME/voyager-keymap/layout.json, from Oryx
      when --layout is given, else from Keymapp's local cache. Prints one JSON
      status line.

  voyager-keymap watch
      Prints a JSON line each time Keymapp reports a different keyboard state or
      active layer. Needs Keymapp running with its API enabled; runs grpcio
      through uv.
"""

import argparse
import json
import os
import re
import sqlite3
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "voyager-keymap"
CACHE = STATE_DIR / "layout.json"
KEYMAPP_DIR = HOME / ".config" / ".keymapp"
KEYMAPP_DB = KEYMAPP_DIR / "keymapp.sqlite3"
KEYMAPP_SOCKET = KEYMAPP_DIR / "keymapp.sock"
ORYX_API = "https://oryx.zsa.io/graphql"
ORYX_QUERY = (
    "query getLayout($hashId: String!, $revisionId: String!, $geometry: String) {"
    " layout(hashId: $hashId, geometry: $geometry, revisionId: $revisionId) {"
    " hashId title geometry revision { hashId createdAt title"
    " layers { title position color keys } } } }"
)
